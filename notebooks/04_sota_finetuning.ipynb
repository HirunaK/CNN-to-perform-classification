    "import os\n",
    "import sys\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torchvision import datasets, transforms\n",
    "from torch.utils.data import DataLoader\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import precision_recall_fscore_support\n",
    "\n",
    "PROJECT_ROOT = os.path.abspath(os.path.join(os.getcwd(), \"..\"))\n",
    "if PROJECT_ROOT not in sys.path:\n",
    "    sys.path.append(PROJECT_ROOT)\n",
    "\n",
    "from models.sota_models import get_mobilenet_v2, get_efficientnet_b0\n",
    "from utils.metrics import compute_and_plot_metrics\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "TRAIN_DIR = os.path.join(PROJECT_ROOT, \"data\", \"train\")\n",
    "VAL_DIR = os.path.join(PROJECT_ROOT, \"data\", \"val\")\n",
    "TEST_DIR = os.path.join(PROJECT_ROOT, \"data\", \"test\")\n",
    "\n",
    "train_dataset = datasets.ImageFolder(root=TRAIN_DIR, transform=transform)\n",
    "val_dataset = datasets.ImageFolder(root=VAL_DIR, transform=transform)\n",
    "test_dataset = datasets.ImageFolder(root=TEST_DIR, transform=transform)\n",
    "\n",
    "if train_dataset.classes != val_dataset.classes or train_dataset.classes != test_dataset.classes:\n",
    "    raise ValueError(\"Train, validation, and test datasets must have the same class order.\")\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True)\n",
    "val_loader = DataLoader(val_dataset, batch_size=32, shuffle=False)\n",
    "test_loader = DataLoader(test_dataset, batch_size=32, shuffle=False)\n",
    "class_names = train_dataset.classes\n",
    "\n",
    "print(f\"Training images: {len(train_dataset):,}\")\n",
    "print(f\"Validation images: {len(val_dataset):,}\")\n",
    "print(f\"Test images: {len(test_dataset):,}\")\n",
    "print(f\"Classes: {len(class_names)} ({', '.join(class_names)})\")\n",
    "\n",
    "sota_models = {\n",
    "    'MobileNetV2': get_mobilenet_v2(num_classes=5),\n",
    "    'EfficientNet-B0': get_efficientnet_b0(num_classes=5)\n",
    "}\n",
    "\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "num_epochs = 20\n",
    "results = {}\n",
    "\n",
    "for name, model in sota_models.items():\n",
    "    total_parameters = sum(parameter.numel() for parameter in model.parameters())\n",
    "    model_size_bytes = sum(\n",
    "        tensor.numel() * tensor.element_size() for tensor in model.state_dict().values()\n",
    "    )\n",
    "    model_size_mb = model_size_bytes / 1_000_000\n",
    "\n",
    "    print(f\"\\nFine-tuning {name}...\")\n",
    "    print(f\"Total parameters: {total_parameters:,}\")\n",
    "    print(f\"Model state size: {model_size_mb:.2f} MB (parameters and buffers)\")\n",
    "    model.to(device)\n",
    "    optimizer = optim.Adam(model.parameters(), lr=0.0005) # Lower LR for fine-tuning\n",
    "    history = {\"train_loss\": [], \"val_loss\": [], \"train_accuracy\": [], \"val_accuracy\": []}\n",
    "\n",
    "    # Train for 20 epochs\n",
    "    for epoch in range(num_epochs):\n",
    "        model.train()\n",
    "        running_loss = 0.0\n",
    "        correct_predictions = 0\n",
    "        examples_seen = 0\n",
    "\n",
    "        for inputs, labels in train_loader:\n",
    "            inputs, labels = inputs.to(device), labels.to(device)\n",
    "            optimizer.zero_grad()\n",
    "            outputs = model(inputs)\n",
    "            loss = criterion(outputs, labels)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            batch_size = labels.size(0)\n",
    "            running_loss += loss.item() * batch_size\n",
    "            correct_predictions += (outputs.argmax(dim=1) == labels).sum().item()\n",
    "            examples_seen += batch_size\n",
    "\n",
    "        train_loss = running_loss / examples_seen\n",
    "        train_accuracy = correct_predictions / examples_seen\n",
    "\n",
    "        model.eval()\n",
    "        val_running_loss = 0.0\n",
    "        val_correct = 0\n",
    "        val_examples_seen = 0\n",
    "        with torch.no_grad():\n",
    "            for inputs, labels in val_loader:\n",
    "                inputs, labels = inputs.to(device), labels.to(device)\n",
    "                outputs = model(inputs)\n",
    "                loss = criterion(outputs, labels)\n",
    "                batch_size = labels.size(0)\n",
    "                val_running_loss += loss.item() * batch_size\n",
    "                val_correct += (outputs.argmax(dim=1) == labels).sum().item()\n",
    "                val_examples_seen += batch_size\n",
    "\n",
    "        val_loss = val_running_loss / val_examples_seen\n",
    "        val_accuracy = val_correct / val_examples_seen\n",
    "        history[\"train_loss\"].append(train_loss)\n",
    "        history[\"val_loss\"].append(val_loss)\n",
    "        history[\"train_accuracy\"].append(train_accuracy)\n",
    "        history[\"val_accuracy\"].append(val_accuracy)\n",
    "        print(\n",
    "            f\"Epoch [{epoch + 1:02d}/{num_epochs:02d}] - \"\n",
    "            f\"Train Loss: {train_loss:.4f}, Train Acc: {train_accuracy:.2%} | \"\n",
    "            f\"Val Loss: {val_loss:.4f}, Val Acc: {val_accuracy:.2%}\"\n",
    "        )\n",
    "\n",
    "    results[name] = {\n",
    "        \"history\": history,\n",
    "        \"total_parameters\": total_parameters,\n",
    "        \"model_size_mb\": model_size_mb,\n",
    "    }\n",
    "\n",
    "    # Evaluate once on the held-out test set after training.\n",
    "    model.eval()\n",
    "    all_preds, all_labels = [], []\n",
    "    with torch.no_grad():\n",
    "        for inputs, labels in test_loader:\n",
    "            inputs, labels = inputs.to(device), labels.to(device)\n",
    "            outputs = model(inputs)\n",
    "            preds = outputs.argmax(dim=1)\n",
    "            all_preds.extend(preds.cpu().numpy())\n",
    "            all_labels.extend(labels.cpu().numpy())\n",
    "\n",
    "    _, _, macro_f1, _ = precision_recall_fscore_support(\n",
    "        all_labels, all_preds, average=\"macro\", zero_division=0\n",
    "    )\n",
    "    test_accuracy = sum(pred == label for pred, label in zip(all_preds, all_labels)) / len(all_labels)\n",
    "    results[name][\"test_accuracy\"] = test_accuracy\n",
    "    results[name][\"test_macro_f1\"] = macro_f1\n",
    "\n",
    "    # Print per-class metrics and plot the held-out test confusion matrix.\n",
    "    compute_and_plot_metrics(all_labels, all_preds, class_names, model_name=name)\n",
    "\n",
    "# Plot train/validation learning curves for both architectures.\n",
    "epochs = range(1, num_epochs + 1)\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "for name, result in results.items():\n",
    "    history = result[\"history\"]\n",
    "    axes[0].plot(epochs, history[\"train_loss\"], label=f\"{name} train\")\n",
    "    axes[0].plot(epochs, history[\"val_loss\"], linestyle=\"--\", label=f\"{name} validation\")\n",
    "    axes[1].plot(epochs, history[\"train_accuracy\"], label=f\"{name} train\")\n",
    "    axes[1].plot(epochs, history[\"val_accuracy\"], linestyle=\"--\", label=f\"{name} validation\")\n",
    "\n",
    "axes[0].set(title=\"Training and Validation Loss\", xlabel=\"Epoch\", ylabel=\"Cross-Entropy Loss\")\n",
    "axes[1].set(title=\"Training and Validation Accuracy\", xlabel=\"Epoch\", ylabel=\"Accuracy\")\n",
    "for axis in axes:\n",
    "    axis.grid(True)\n",
    "    axis.legend()\n",
    "fig.tight_layout()\n",
    "fig.savefig(\"sota_training_curves.png\")\n",
    "plt.show()\n",
    "\n",
    "# Compare final test-set accuracy and macro F1, alongside size/parameter counts.\n",
    "model_names = list(results)\n",
    "x = range(len(model_names))\n",
    "width = 0.35\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "ax.bar([position - width / 2 for position in x],\n",
    "       [results[name][\"test_accuracy\"] for name in model_names], width, label=\"Test accuracy\")\n",
    "ax.bar([position + width / 2 for position in x],\n",
    "       [results[name][\"test_macro_f1\"] for name in model_names], width, label=\"Test macro F1\")\n",
    "ax.set_xticks(list(x), model_names)\n",
    "ax.set_ylim(0, 1)\n",
    "ax.set_ylabel(\"Score\")\n",
    "ax.set_title(\"Held-out Test Performance\")\n",
    "ax.legend()\n",
    "ax.grid(axis=\"y\")\n",
    "fig.tight_layout()\n",
    "fig.savefig(\"sota_test_metrics.png\")\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nTest-set summary\")\n",
    "print(f\"{'Model':<18} {'Parameters':>15} {'Size (MB)':>12} {'Accuracy':>12} {'Macro F1':>12}\")\n",
    "for name, result in results.items():\n",
    "    print(\n",
    "        f\"{name:<18} {result['total_parameters']:>15,} \"\n",
    "        f\"{result['model_size_mb']:>12.2f} \"\n",
    "        f\"{result['test_accuracy']:>11.2%} \"\n",
    "        f\"{result['test_macro_f1']:>12.4f}\"\n",
    "    )\n",
   ]
  }
 ],
